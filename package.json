{
  "name": "shader-art",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Build pure fragment-shader art as graphs of typed nodes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "sass-embedded": "^1.104.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
